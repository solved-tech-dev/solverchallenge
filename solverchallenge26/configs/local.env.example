# Copy this file to configs/local.env only when the default local/ layout is
# not suitable. Environment variables already set by the caller take priority.

# XIANZHIKRYLOV_ROOT=/absolute/path/to/xianzhikrylov
# PANGULU_ROOT=/absolute/path/to/pangulu
# SC26_LINGLONGAMG_LIBRARY=/absolute/path/to/liblinglongamg.so
# SC26_PANGULU_LIBRARY=/absolute/path/to/libpangulu.so

# XIANZHIKRYLOV_LICENSE_PATHS=/absolute/path/to/xianzhikrylov.license.key
# LINGLONGAMG_LICENSE_PATHS=/absolute/path/to/linglongamg.license.key
# PANGULU_LICENSE_PATHS=/absolute/path/to/pangulu.license.key

# SC26_HIP_RUNTIME_LIBRARY=/absolute/path/to/libamdhip64.so
