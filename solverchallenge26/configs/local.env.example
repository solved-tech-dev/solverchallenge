# Copy this file to configs/local.env only when the default local/ layout is
# not suitable. Environment variables already set by the caller take priority.

# PANGULU_ROOT=/absolute/path/to/pangulu
# SC26_PANGULU_LIBRARY=/absolute/path/to/libpangulu.so
# SC26_LINGLONGAMG_LIBRARY=/absolute/path/to/liblinglongamg.so
# XIANZHIKRYLOV_ROOT=/absolute/path/to/xianzhikrylov

# Competition-cluster matrix directory:
# SC26_DATA_ROOT=/public/share/ac3k88uz8y/SolverChallenge26-TenProblems

# PANGULU_LICENSE_PATHS=/absolute/path/to/pangulu.license.key
# LINGLONGAMG_LICENSE_PATHS=/absolute/path/to/linglongamg.license.key
# XIANZHIKRYLOV_LICENSE_PATHS=/absolute/path/to/xianzhikrylov.license.key

# SC26_HIP_RUNTIME_LIBRARY=/absolute/path/to/libamdhip64.so

# Optional: site-provided glibc compatibility directory containing
# ld-linux-x86-64.so.2 and its matching runtime libraries.
# Keep this directory out of the shell's LD_LIBRARY_PATH.
# export SC26_COMPAT_ROOT="/absolute/path/to/site/compat-runtime"

# The scripts choose a writable fallback automatically. Set TMPDIR explicitly
# when your preferred work storage is not discoverable or has a larger quota.
# export TMPDIR="/path/to/your/writable/tmp/solverchallenge26"

# Select the DTK build that matches the downloaded product packages.
# export SC26_HIP_RUNTIME_LIBRARY=/public/software/compiler/dtk-<version>/hip/lib/libgalaxyhip.so.5
