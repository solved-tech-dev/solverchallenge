# BW1000 settings used with the matching product packages.
export XK_AMG_APPLY_ONE_CYCLE=1 XK_DILU_FUSED_SWEEP=1 XK_DILU_COARSE_ZERO=1 XK_DILU_EXACT_ZERO=1

# Block DILU and coarse-level settings for the 8-second T5 configuration.
export T5_DILU_PACKED=2
export T5_DILU_SORT_ROWS=1
export T5_DILU_GREEDY_COLOR=1
export T5_DILU_FAST_SETUP=1
export T5_DILU_FLOAT_APPLY=1
export T5_DILU_FUSED_RESIDUAL=1
export T5_DILU_DENSE_GRAPH=1
export T5_DILU_DENSE_FACTOR=1
export T5_DILU_FACTOR_WAVE=2
export T5_BLOCK_RAP=1
export T5_COARSE_DENSE=1
export T5_COARSE_FP32=2
export T5_CYCLE_ZERO=1
export T5_CYCLE_GRAPH=1
export LINGLONG_DILU_CYCLE_GRAPH=1
export LINGLONG_DILU_ROW_WIDTH=0

# Outer solver: FGMRES(32) with reduced-precision basis storage and two-pass orthogonalization.
export T5_OUTER_BLOCK_WIDTH=4
export T5_OUTER_FGMRES=32
export T5_FGMRES_Z32=1
export T5_FGMRES_V32=1
export T5_FGMRES_CGS2=1

export OMP_NUM_THREADS=16 OMP_DYNAMIC=FALSE OPENBLAS_NUM_THREADS=1 OMP_PROC_BIND=false

export LINGLONG_DILU_PACKED_TPB=512 LINGLONG_FUSED_RESIDUAL_RESTRICT_MAX_LEVEL=0 LINGLONG_FUSED_PROLONGATE=1
export T5_OUTER_FGMRES=48 T5_FGMRES_CGS2=0 T5_OUTER_BLOCK_WIDTH=16
export T5_AGG_SORT_IDS=1 T5_AGG_SORT_MIN_ROWS=1000000
export XK_DIAG_TRIALS=1
