export OMP_NUM_THREADS=16 OMP_DYNAMIC=FALSE OPENBLAS_NUM_THREADS=1
export XI_FILL_CACHE=1 XI_ILU_FILL=5 XI_PROJECT_GROUP=4 XI_MM_TPB=256 XI_MM_WIDTH=16 XI_PATTERN_CACHE=1
